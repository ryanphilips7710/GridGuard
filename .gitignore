# ==============================================================================
# GridGuard - Git Ignore Rules
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
include/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Vercel & Deployment Artifacts ---
.vercel/
dist/
build/
*.egg-info/
.eggs/

# --- Logs & Databases ---
*.log
*.sqlite
*.sqlite3
*.db

# --- Editor & IDE Configs ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- OS Specific Files ---
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*.tmp
